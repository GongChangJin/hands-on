{
  "container_image": "gongchangjin-security-tools:09-v1",
  "semgrep_version": "1.178.0",
  "bandit_version": "1.9.4",
  "pytest_version": "9.1.1",
  "network": "none",
  "read_only_root": true,
  "cap_drop": ["ALL"],
  "no_new_privileges": true,
  "memory_mb": 768,
  "cpus": 1.0,
  "pids_limit": 128,
  "timeout_seconds": 60,
  "allowed_tools": ["semgrep", "bandit", "pytest"],
  "allowed_categories": ["sqli", "path_traversal", "hardcoded_secret"],
  "minimum_detection_rate": 1.0,
  "minimum_remediation_rate": 0.8
}

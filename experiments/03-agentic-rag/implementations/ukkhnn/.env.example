# 실제 키는 파일에 저장하지 않고 현재 터미널에만 설정합니다.
UPSTAGE_API_KEY=
DEEPSEEK_API_KEY=
AGENT_PROVIDER=upstage
AGENT_MODEL=

# 01-agent-evaluation과 같은 로컬 Phoenix collector를 재사용합니다.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=03-agentic-rag

# 임베딩은 로컬에서 실행되고 외부 embedding API를 사용하지 않습니다.
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_SCORE_THRESHOLD=0.45
RAG_TOP_K=4
RAG_MAX_RETRIES=1

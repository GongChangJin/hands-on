# 실제 키는 파일에 저장하지 않고 현재 터미널 환경 변수로만 설정합니다.
DEEPSEEK_API_KEY=

# 01-agent-evaluation의 Phoenix collector와 volume을 그대로 재사용합니다.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=04-multimodal-agent

# DeepSeek 고정 endpoint와 vision model을 사용합니다. OPENAI_* 변수는 읽지 않습니다.
DEEPSEEK_MODEL=deepseek-v4-flash-vision-exp

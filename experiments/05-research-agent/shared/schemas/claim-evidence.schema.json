{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gongchangjin:research-agent:claim-evidence",
  "title": "ClaimEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "claim", "claim_type", "paper_record_id", "paper_title", "identifiers", "source_url", "evidence_location", "evidence_type", "paraphrase", "verified"],
  "properties": {
    "claim_id": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "claim_type": {"enum": ["paper_result", "cross_paper_synthesis"]},
    "paper_record_id": {"type": "string", "minLength": 1},
    "paper_title": {"type": "string", "minLength": 1},
    "identifiers": {"type": "object", "minProperties": 1},
    "source_url": {"type": "string", "pattern": "^https://"},
    "evidence_location": {"type": "string", "minLength": 1},
    "evidence_type": {"enum": ["abstract", "full_text"]},
    "quote": {"type": ["string", "null"], "maxLength": 500},
    "paraphrase": {"type": "string", "minLength": 1},
    "verified": {"const": true},
    "extraction_uncertainty": {"type": "string"}
  }
}

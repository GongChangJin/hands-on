{
  "max_attempts": 2,
  "max_changed_files": 2,
  "max_file_bytes": 20000,
  "command_timeout_seconds": 30,
  "allowed_tools": ["repository.read", "repository.write", "test.pytest", "lint.ruff"],
  "forbidden_actions": [
    "git_push",
    "git_commit",
    "git_reset",
    "git_checkout",
    "git_clean",
    "network_access",
    "write_outside_workspace",
    "read_held_out_tests"
  ]
}

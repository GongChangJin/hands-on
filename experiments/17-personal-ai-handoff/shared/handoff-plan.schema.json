{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gongchangjin:hands-on:source-only-handoff",
  "$comment": "The runtime validator additionally rejects traversal, sensitive/runtime-state filenames and duplicate file paths. Validate untrusted imports with validateHandoffPlan, not this structural schema alone.",
  "title": "SourceOnlyHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "source", "target", "checks", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "source-only-handoff" },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "revision", "files"],
      "properties": {
        "repository": { "type": "string", "pattern": "^(fixture://[a-z0-9-]+|https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)$" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "files": {
          "type": "array", "minItems": 1, "maxItems": 1000,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$" },
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["requires_new_task", "auto_resume"],
      "properties": { "requires_new_task": { "const": true }, "auto_resume": { "const": false } }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["delivery_completed", "queue_empty", "runtime_idle", "approval_consumed", "source_clean", "tests_passed"],
      "properties": {
        "delivery_completed": { "const": true }, "queue_empty": { "const": true }, "runtime_idle": { "const": true },
        "approval_consumed": { "const": true }, "source_clean": { "const": true }, "tests_passed": { "const": true }
      }
    },
    "steps": { "const": ["fetch-source", "verify-revision-and-file-hashes", "prepare-host-with-local-auth", "create-new-project-and-task", "run-local-checks", "request-first-execution"] }
  }
}
